ADDR=:8080
BASE_URL=http://localhost:8080
DEBUG=false
DB_DSN=postgres://postgres:postgres@localhost:5432/nutmeg?sslmode=disable

# LLM_PROVIDER picks which LLM backend is used — "ollama" (local/
# self-hosted, default) or "google" (Google's Generative Language API,
# e.g. to run Gemma directly). The same LLM_BASE_URL/LLM_API_KEY/LLM_MODEL
# names are shared across providers, reinterpreted per provider (Ollama
# ignores LLM_API_KEY since it needs no auth; Google ignores LLM_BASE_URL
# since its endpoint is fixed). Only LLM_PROVIDER needs to change to
# switch — just remember to update LLM_MODEL (and LLM_API_KEY) to match
# whichever provider you're switching to.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
# Ollama tag (e.g. llama3.1:8b) or Google model id (verify against
# https://ai.google.dev/gemini-api/docs/models) depending on LLM_PROVIDER.
LLM_MODEL=llama3.1:8b

# Optional — leave SMTP_HOST blank to disable email sending (no-op, logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@nutmeg.local

EZAUTH_JWT_SECRET=change-me
EZAUTH_DB_DIALECT=postgres
EZAUTH_DB_DSN=postgres://postgres:postgres@localhost:5432/nutmeg?sslmode=disable
EZAUTH_ADDR=:8080
EZAUTH_BASE_URL=http://localhost:8080
EZAUTH_DEBUG=true
EZAUTH_REDIRECT_AFTER_LOGIN=/groups
EZAUTH_REDIRECT_AFTER_LOGOUT=/login
