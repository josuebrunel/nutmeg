package components

// ShareWidget renders a share button (Web Share API on supporting devices,
// otherwise a small copy-link/X/WhatsApp menu — see static/js/share.js).
// title is used as the share text/tweet text; the URL shared is always
// window.location.href at click time, never server-rendered.
templ ShareWidget(title string) {
	<div class="relative inline-block share-widget" data-share-title={ title }>
		<button type="button" class="share-btn font-oswald text-sm text-chalk hover:text-gold transition-colors flex items-center gap-1.5 border border-chalk/30 rounded-sm px-3 py-1.5 shrink-0" aria-label="Share">
			@IconShare("size-4")
			Share
		</button>
		<div class="share-menu hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-pitch/10 z-20 overflow-hidden">
			<button type="button" class="share-copy-link w-full text-left px-4 py-2 text-sm font-body text-ink hover:bg-base-200">Copy Link</button>
			<button type="button" class="share-x w-full text-left px-4 py-2 text-sm font-body text-ink hover:bg-base-200">Share on X</button>
			<button type="button" class="share-whatsapp w-full text-left px-4 py-2 text-sm font-body text-ink hover:bg-base-200">Share on WhatsApp</button>
		</div>
	</div>
}
