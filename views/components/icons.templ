package components

templ IconUsers(class string) {
	<iconify-icon icon="mdi:account-multiple" class={ "size-5", class }></iconify-icon>
}

templ IconGroup(class string) {
	<iconify-icon icon="mdi:view-grid" class={ "size-5", class }></iconify-icon>
}

templ IconTeam(class string) {
	<iconify-icon icon="mdi:account-group" class={ "size-5", class }></iconify-icon>
}

templ IconMatch(class string) {
	<iconify-icon icon="mdi:soccer-field" class={ "size-5", class }></iconify-icon>
}

templ IconStats(class string) {
	<iconify-icon icon="mdi:chart-bar" class={ "size-5", class }></iconify-icon>
}

templ IconPlus(class string) {
	<iconify-icon icon="mdi:plus" class={ "size-5", class }></iconify-icon>
}

templ IconTrash(class string) {
	<iconify-icon icon="mdi:trash-can-outline" class={ "size-5", class }></iconify-icon>
}

templ IconEdit(class string) {
	<iconify-icon icon="mdi:pencil" class={ "size-5", class }></iconify-icon>
}

templ IconCheck(class string) {
	<iconify-icon icon="mdi:check" class={ "size-5", class }></iconify-icon>
}

templ IconClose(class string) {
	<iconify-icon icon="mdi:close" class={ "size-5", class }></iconify-icon>
}

// IconGoal is a soccer ball — used for goal counts/stats.
templ IconGoal(class string) {
	<iconify-icon icon="mdi:soccer" class={ "size-5", class }></iconify-icon>
}

templ IconShare(class string) {
	<iconify-icon icon="mdi:share-variant" class={ "size-5", class }></iconify-icon>
}

// IconShield marks clean sheets / defensive performance.
templ IconShield(class string) {
	<iconify-icon icon="mdi:shield-check" class={ "size-5", class }></iconify-icon>
}

// IconArrowUp marks a "promote this person" action — used only by the
// roster row's Promote button.
templ IconArrowUp(class string) {
	<iconify-icon icon="mdi:account-arrow-up" class={ "size-5", class }></iconify-icon>
}

// IconArrowDown marks a "demote this person" action — used only by the
// roster row's Demote button.
templ IconArrowDown(class string) {
	<iconify-icon icon="mdi:account-arrow-down" class={ "size-5", class }></iconify-icon>
}

templ IconWhistle(class string) {
	<iconify-icon icon="mdi:whistle" class={ "size-5", class }></iconify-icon>
}

// IconBoot is a soccer cleat — used for assist counts/stats.
templ IconBoot(class string) {
	<iconify-icon icon="mdi:shoe-cleat" class={ "size-5", class }></iconify-icon>
}

templ IconJersey(class string) {
	<iconify-icon icon="mdi:tshirt-crew" class={ "size-5", class }></iconify-icon>
}

templ IconCornerFlag(class string) {
	<iconify-icon icon="mdi:flag-variant" class={ "size-5", class }></iconify-icon>
}

templ IconTrophy(class string) {
	<iconify-icon icon="mdi:trophy" class={ "size-5", class }></iconify-icon>
}

// IconNews marks the group News feed (signing blurbs + match reports).
templ IconNews(class string) {
	<iconify-icon icon="mdi:newspaper-variant-outline" class={ "size-5", class }></iconify-icon>
}

// IconSparkle marks AI-generated content (commentary roasts, news copy).
templ IconSparkle(class string) {
	<iconify-icon icon="mdi:auto-awesome" class={ "size-5", class }></iconify-icon>
}

// IconCrown marks the group admin role.
templ IconCrown(class string) {
	<iconify-icon icon="mdi:crown" class={ "size-5", class }></iconify-icon>
}

// IconHelp marks the Help nav link.
templ IconHelp(class string) {
	<iconify-icon icon="mdi:help-circle-outline" class={ "size-5", class }></iconify-icon>
}
