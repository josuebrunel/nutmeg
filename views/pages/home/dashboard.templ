package home

import (
	"nutmeg/internal/model"
	"nutmeg/internal/repository"
	components "nutmeg/views/components"
)

templ Dashboard(groups []*model.Group, stats *repository.GlobalStats) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="stadium-gradient rounded-xl px-5 py-6 sm:px-8 sm:py-8 mb-12">
			<div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3 mb-6">
				<div>
					<h2 class="font-oswald text-4xl text-chalk font-bold">YOUR STATS</h2>
					<p class="text-chalk/70 font-body mt-1">Your groups and activity at a glance</p>
				</div>
				<form hx-post="/groups" hx-target="#dashboard-groups" hx-swap="outerHTML" class="flex gap-2 w-full sm:w-auto">
					<input type="text" name="name" placeholder="New group name" class="flex-grow sm:w-48 bg-chalk/10 border-2 border-chalk/30 text-chalk placeholder-chalk/50 rounded px-3 py-2 text-sm focus:border-turf focus:outline-none" required />
					<button type="submit" class="font-oswald bg-turf text-pitch-night px-4 py-2 rounded hover:bg-gold transition-colors text-sm whitespace-nowrap">Create</button>
				</form>
			</div>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				<div class="scoreboard-tile text-center">
					<div class="flex justify-center mb-1 text-turf">@components.IconJersey("size-5")</div>
					<div class="scoreboard-lbl">Groups</div>
					<div class="scoreboard-num">{ len(groups) }</div>
				</div>
				<div class="scoreboard-tile text-center">
					<div class="flex justify-center mb-1 text-turf">@components.IconWhistle("size-5")</div>
					<div class="scoreboard-lbl">Total Matches</div>
					<div class="scoreboard-num">{ stats.TotalMatches }</div>
				</div>
				<div class="scoreboard-tile text-center">
					<div class="flex justify-center mb-1 text-turf">@components.IconGoal("size-5")</div>
					<div class="scoreboard-lbl">Total Goals</div>
					<div class="scoreboard-num">{ stats.TotalGoals }</div>
				</div>
				<div class="scoreboard-tile text-center">
					<div class="flex justify-center mb-1 text-turf">@components.IconUsers("size-5")</div>
					<div class="scoreboard-lbl">Total Players</div>
					<div class="scoreboard-num">{ stats.TotalPlayers }</div>
				</div>
			</div>
		</div>
		@DashboardGroupList(groups)
	</div>
}

templ DashboardGroupList(groups []*model.Group) {
	<div id="dashboard-groups">
		<h3 class="font-oswald text-2xl text-pitch font-bold mb-4">YOUR GROUPS</h3>
		if len(groups) == 0 {
			<div class="col-span-full p-8 text-center border-2 border-dashed border-pitch/20 rounded-xl text-ink/60">
				<p class="font-body">You aren't in any groups yet. Create one above!</p>
			</div>
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				for _, g := range groups {
					<a href={ templ.URL("/groups/" + g.ID) } class="relative block bg-white p-6 rounded-xl shadow border-2 border-transparent hover:border-gold transition-all group overflow-hidden">
						<div class="absolute top-3 right-3 text-pitch/10 group-hover:text-gold/30 transition-colors">
							@components.IconCornerFlag("size-10")
						</div>
						<h4 class="relative font-oswald text-xl text-pitch mb-2 group-hover:text-gold transition-colors">{ g.Name }</h4>
						if g.Description != nil {
							<p class="relative font-body text-sm text-ink/60">{ *g.Description }</p>
						}
						<div class="grass-stripe-accent h-1 -mx-6 -mb-6 mt-4"></div>
					</a>
				}
			</div>
		}
	</div>
}
