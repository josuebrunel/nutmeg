package matches

import (
	"strings"
	"time"

	"nutmeg/internal/repository"
	components "nutmeg/views/components"
)

type MatchEditData struct {
	MatchID   string
	TeamAName string
	TeamBName string
	ScoreA    int
	ScoreB    int
	Teams     map[string]string
	Goals     map[string]int
	Assists   map[string]int
	PlayedAt  time.Time
}

func formAction(groupID string, editData *MatchEditData) string {
	if editData != nil {
		return "/groups/" + groupID + "/matches/" + editData.MatchID + "/update"
	}
	return "/groups/" + groupID + "/matches"
}

func scoreValue(editData *MatchEditData, team string) int {
	if editData == nil {
		return 0
	}
	if team == "a" {
		return editData.ScoreA
	}
	return editData.ScoreB
}

func intVal(editData *MatchEditData, playerID string) int {
	if editData == nil {
		return 0
	}
	if v, ok := editData.Goals[playerID]; ok {
		return v
	}
	return 0
}

func assistVal(editData *MatchEditData, playerID string) int {
	if editData == nil {
		return 0
	}
	if v, ok := editData.Assists[playerID]; ok {
		return v
	}
	return 0
}

func teamVal(editData *MatchEditData, playerID string) string {
	if editData == nil {
		return ""
	}
	if v, ok := editData.Teams[playerID]; ok {
		return v
	}
	return ""
}

func teamName(editData *MatchEditData, team string) string {
	if editData == nil {
		if team == "a" {
			return "Shirts"
		}
		return "Skins"
	}
	if team == "a" {
		return editData.TeamAName
	}
	return editData.TeamBName
}

// playedAtValue returns the date-input value: today for a new match, or the
// match's stored date when editing.
func playedAtValue(editData *MatchEditData) string {
	if editData == nil {
		return time.Now().Format("2006-01-02")
	}
	return editData.PlayedAt.Format("2006-01-02")
}

// scoreIsManual marks the score fields as pre-filled/manual when editing an
// existing match, so the live goal-tally calculation (which is only useful
// while first logging a match) never silently overwrites a saved score.
func scoreIsManual(editData *MatchEditData) string {
	if editData != nil {
		return "true"
	}
	return "false"
}

templ LogForm(groupID string, members []repository.MemberInfo, editData *MatchEditData) {
	<div>
		<button hx-get={ templ.URL("/groups/" + groupID + "/detail-content") } hx-target="#detail-content-area" hx-swap="innerHTML" class="inline-flex items-center text-turf hover:text-pitch font-oswald mb-6">
			&larr; Cancel
		</button>
		<div class="bg-white p-4 sm:p-6 rounded-xl shadow border-2 border-pitch">
			<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
				<h3 class="font-oswald text-2xl text-pitch font-bold">
					if editData != nil {
						EDIT MATCH RESULT
					} else {
						LOG MATCH RESULT
					}
				</h3>
				<div class="flex items-center gap-2">
					<label for="played_at" class="font-oswald text-xs text-turf">Date Played</label>
					<input type="date" id="played_at" name="played_at" form="match-form" value={ playedAtValue(editData) } class="border border-pitch/30 rounded px-2 py-1 text-sm font-mono"/>
				</div>
			</div>
			<form id="match-form" method="POST" action={ templ.URL(formAction(groupID, editData)) } hx-target="body" class="space-y-6">
				<div>
					<div class="flex justify-between items-end mb-3">
						<h3 class="font-oswald text-xl text-turf flex items-center gap-2">@components.IconUsers("size-5") 1. Tap Each Player's Team, Then Tally Goals &amp; Assists</h3>
					</div>
					<div class="bg-base-200 p-4 rounded">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							for _, m := range members {
								<div class="match-player-row bg-white p-2 border border-pitch/10 rounded shadow-sm">
									<div class="flex items-center justify-between gap-2 mb-1">
										<span class="text-sm font-body font-semibold truncate">{ m.Name }</span>
										<div class="team-toggle inline-flex rounded overflow-hidden border border-pitch/30 shrink-0 text-xs font-oswald">
											<label class="team-opt px-2 py-1 cursor-pointer bg-chalk">
												<input type="radio" name={ "team_" + m.ID } value="" class="team-radio sr-only" if teamVal(editData, m.ID) == "" { checked }/>
												OUT
											</label>
											<label class="team-opt px-2 py-1 cursor-pointer bg-chalk border-l border-pitch/30">
												<input type="radio" name={ "team_" + m.ID } value="a" class="team-radio sr-only" if teamVal(editData, m.ID) == "a" { checked }/>
												A
											</label>
											<label class="team-opt px-2 py-1 cursor-pointer bg-chalk border-l border-pitch/30">
												<input type="radio" name={ "team_" + m.ID } value="b" class="team-radio sr-only" if teamVal(editData, m.ID) == "b" { checked }/>
												B
											</label>
										</div>
									</div>
									<div class="flex items-center gap-3">
									<div class="goal-stepper items-center gap-1 shrink-0">
										@components.IconGoal("size-4")
										<button type="button" class="goal-dec w-6 h-6 rounded-full border border-pitch/30 font-mono text-sm leading-none hover:bg-base-200" aria-label={ "Decrease goals for " + m.Name }>&minus;</button>
										<span class="goal-count w-4 text-center text-sm font-mono">{ intVal(editData, m.ID) }</span>
										<button type="button" class="goal-inc w-6 h-6 rounded-full border border-pitch/30 font-mono text-sm leading-none hover:bg-base-200" aria-label={ "Increase goals for " + m.Name }>+</button>
										<input type="hidden" name={ "goals_" + m.ID } class="goal-input" value={ intVal(editData, m.ID) }/>
									</div>
									<div class="assist-stepper items-center gap-1 shrink-0">
										@components.IconBoot("size-4")
										<button type="button" class="assist-dec w-6 h-6 rounded-full border border-pitch/30 font-mono text-sm leading-none hover:bg-base-200" aria-label={ "Decrease assists for " + m.Name }>&minus;</button>
										<span class="assist-count w-4 text-center text-sm font-mono">{ assistVal(editData, m.ID) }</span>
										<button type="button" class="assist-inc w-6 h-6 rounded-full border border-pitch/30 font-mono text-sm leading-none hover:bg-base-200" aria-label={ "Increase assists for " + m.Name }>+</button>
										<input type="hidden" name={ "assists_" + m.ID } class="assist-input" value={ assistVal(editData, m.ID) }/>
									</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
				<div>
					<h3 class="font-oswald text-xl text-turf flex items-center gap-2 mb-3">@components.IconEdit("size-5") 2. Team Names <span class="text-ink/40 normal-case text-xs font-body">(optional)</span></h3>
					<div class="flex items-center justify-center gap-4 sm:gap-8 bg-base-200 p-4 rounded">
						<div class="text-center">
							<label class="font-oswald text-sm mb-1 block">Team A Name</label>
							<input type="text" name="team_a_name" value={ teamName(editData, "a") } class="w-28 sm:w-36 text-center text-sm font-mono border-2 border-pitch/30 rounded py-1.5"/>
						</div>
						<div class="font-oswald text-2xl text-ink/30">VS</div>
						<div class="text-center">
							<label class="font-oswald text-sm mb-1 block">Team B Name</label>
							<input type="text" name="team_b_name" value={ teamName(editData, "b") } class="w-28 sm:w-36 text-center text-sm font-mono border-2 border-pitch/30 rounded py-1.5"/>
						</div>
					</div>
				</div>
				<div>
					<h3 class="font-oswald text-xl text-turf mb-3">3. Final Score <span class="text-ink/40 normal-case text-xs font-body">(filled in from goals above &mdash; edit if needed)</span></h3>
					<div class="flex items-center justify-center gap-4 sm:gap-8 bg-pitch p-6 rounded text-chalk">
						<div class="text-center">
							<label class="font-oswald text-lg mb-2 block">{ strings.ToUpper(teamName(editData, "a")) }</label>
							<input type="number" name="score_a" min="0" value={ scoreValue(editData, "a") } data-team="a" data-manual={ scoreIsManual(editData) } required class="score-input w-20 sm:w-24 text-center text-3xl sm:text-4xl font-mono text-chalk py-2 rounded border-0"/>
						</div>
						<div class="font-oswald text-3xl text-gold">-</div>
						<div class="text-center">
							<label class="font-oswald text-lg mb-2 block">{ strings.ToUpper(teamName(editData, "b")) }</label>
							<input type="number" name="score_b" min="0" value={ scoreValue(editData, "b") } data-team="b" data-manual={ scoreIsManual(editData) } required class="score-input w-20 sm:w-24 text-center text-3xl sm:text-4xl font-mono text-chalk py-2 rounded border-0"/>
						</div>
					</div>
				</div>
				<button type="submit" class="w-full font-oswald bg-gold text-pitch border-2 border-gold py-3 rounded hover:bg-pitch hover:text-gold transition-colors text-lg font-bold">
					if editData != nil {
						UPDATE MATCH
					} else {
						SAVE MATCH
					}
				</button>
			</form>
		</div>
	</div>
}
