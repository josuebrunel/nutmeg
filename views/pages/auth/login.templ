package auth

import components "nutmeg/views/components"

templ Login(errMsg string, sucMsg string) {
	<div class="min-h-[80vh] flex items-center justify-center py-12 px-4">
		<div class="bg-white p-8 rounded-xl shadow-lg border-2 border-pitch w-full max-w-md relative overflow-hidden">
			<div class="absolute top-0 left-0 w-full h-2 bg-turf"></div>
			@components.Alert("error", errMsg)
			@components.Alert("success", sucMsg)
			<h2 class="font-oswald text-3xl text-pitch font-bold mb-6 text-center mt-2">SIGN IN</h2>
			<form method="POST" action="/auth/login" class="flex flex-col gap-4">
				@components.FormField(components.FormFieldProps{
					Label:       "Email",
					Type:        "email",
					Name:        "email",
					Required:    true,
					Placeholder: "player@pitch.com",
				})
				@components.FormField(components.FormFieldProps{
					Label:       "Password",
					Type:        "password",
					Name:        "password",
					Required:    true,
					Placeholder: "••••••••",
				})
				<button type="submit" class="w-full font-oswald bg-pitch text-chalk hover:bg-turf py-3 rounded transition-colors text-lg mt-2 flex items-center justify-center gap-2">@components.IconTeam("size-5") SIGN IN</button>
			</form>
			<p class="mt-4 text-sm text-center text-ink/70 font-body">
				No account? <a href="/register" class="font-oswald text-gold hover:text-nutmeg underline">Sign up</a>
			</p>
		</div>
	</div>
}
