package account

import (
	"fmt"

	ezauthmodels "github.com/josuebrunel/ezauth/pkg/db/models"
	components "nutmeg/views/components"
)

templ Form(user *ezauthmodels.User, successMsg string, errMsg string, ownedGroupCount int) {
	<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<h2 class="font-oswald text-3xl text-pitch font-bold mb-6">MY ACCOUNT</h2>
		@components.Alert("error", errMsg)
		@components.Alert("success", successMsg)
		<div class="bg-white p-8 rounded-xl shadow border-2 border-pitch mb-8">
			<h3 class="font-oswald text-xl text-pitch font-bold mb-4">PROFILE</h3>
			<form method="POST" action="/account" class="space-y-4">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					@components.FormField(components.FormFieldProps{
						Label: "First Name",
						Type:  "text",
						Name:  "first_name",
						Value: user.FirstName,
					})
					@components.FormField(components.FormFieldProps{
						Label: "Last Name",
						Type:  "text",
						Name:  "last_name",
						Value: user.LastName,
					})
				</div>
				@components.FormField(components.FormFieldProps{
					Label:       "Username",
					Type:        "text",
					Name:        "username",
					Value:       user.Username,
					Placeholder: "pickup_king",
				})
				@components.FormField(components.FormFieldProps{
					Label:    "Email",
					Type:     "email",
					Name:     "email",
					Value:    user.Email,
					Required: true,
				})
				<button type="submit" class="w-full font-oswald bg-pitch text-chalk hover:bg-turf py-3 rounded transition-colors text-lg mt-2">SAVE CHANGES</button>
			</form>
		</div>
		if user.IsLocal() {
			<div class="bg-white p-8 rounded-xl shadow border-2 border-pitch">
				<h3 class="font-oswald text-xl text-pitch font-bold mb-4">CHANGE PASSWORD</h3>
				<form method="POST" action="/account/password" class="space-y-4">
					@components.FormField(components.FormFieldProps{
						Label:    "Current Password",
						Type:     "password",
						Name:     "current_password",
						Required: true,
					})
					@components.FormField(components.FormFieldProps{
						Label:     "New Password",
						Type:      "password",
						Name:      "new_password",
						Required:  true,
						MinLength: 8,
					})
					@components.FormField(components.FormFieldProps{
						Label:     "Confirm New Password",
						Type:      "password",
						Name:      "new_password_confirm",
						Required:  true,
						MinLength: 8,
					})
					<button type="submit" class="w-full font-oswald bg-pitch text-chalk hover:bg-turf py-3 rounded transition-colors text-lg mt-2">UPDATE PASSWORD</button>
				</form>
			</div>
		}
		<div class="bg-white p-8 rounded-xl shadow border-2 border-nutmeg mt-8">
			<h3 class="font-oswald text-xl text-nutmeg font-bold mb-4">DANGER ZONE</h3>
			if ownedGroupCount > 0 {
				<p class="font-body text-sm text-ink/70">
					{ fmt.Sprintf("You own %d group%s. Delete or transfer ", ownedGroupCount, pluralSuffix(ownedGroupCount)) }
					if ownedGroupCount == 1 {
						it
					} else {
						them
					}
					before you can delete your account.
				</p>
				<a href="/groups" class="inline-block mt-3 font-oswald text-sm text-pitch hover:text-turf transition-colors">Go to my groups →</a>
			} else {
				<p class="font-body text-sm text-ink/70 mb-4">Deleting your account is permanent and can't be undone.</p>
				<form method="POST" action="/account/delete" onsubmit="return confirm('Delete your account? This cannot be undone.')">
					<button type="submit" class="w-full font-oswald bg-nutmeg text-chalk hover:bg-red-700 py-3 rounded transition-colors text-lg">DELETE MY ACCOUNT</button>
				</form>
			}
		</div>
	</div>
}

// pluralSuffix returns "s" unless n is exactly 1, matching the plain-Go
// helper convention used for the same purpose in views/pages/groups.
func pluralSuffix(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}
