package groups

import (
	components "nutmeg/views/components"
)

// ActivityEntry is a group_activity row mapped for display — see
// mapActivityEntries in internal/handler/group.go.
type ActivityEntry struct {
	Kind string
	Text string
	When string
}

templ ActivityFeed(entries []ActivityEntry) {
	if len(entries) > 0 {
		<div class="mt-6">
			<h3 class="font-oswald text-2xl text-pitch mb-4 flex items-center gap-2">
				@components.IconWhistle("size-6")
				ACTIVITY
			</h3>
			<div class="bg-white rounded-lg shadow border border-pitch/20 divide-y divide-pitch/10">
				for _, entry := range entries {
					<div class="p-3 flex items-start gap-3">
						if entry.Kind == "match_logged" {
							@components.IconMatch("size-5 text-pitch shrink-0 mt-0.5")
						} else {
							@components.IconUsers("size-5 text-turf shrink-0 mt-0.5")
						}
						<div>
							<p class="font-body text-sm text-ink">{ entry.Text }</p>
							<p class="font-oswald text-xs text-ink/40">{ entry.When }</p>
						</div>
					</div>
				}
			</div>
		</div>
	}
}
