package groups

import (
	"nutmeg/internal/model"
	components "nutmeg/views/components"
)

templ MemberEditForm(groupID string, m *model.GroupPlayer, errMsg string) {
	<div>
		<button hx-get={ templ.URL("/groups/" + groupID + "/roster-full") } hx-target="#detail-content-area" hx-swap="innerHTML" class="inline-flex items-center text-turf hover:text-pitch font-oswald mb-6">
			&larr; Cancel
		</button>
		<div class="bg-white p-4 sm:p-6 rounded-xl shadow border-2 border-pitch max-w-lg mx-auto">
			<h3 class="font-oswald text-2xl text-pitch font-bold mb-6">EDIT PLAYER</h3>
			@components.Alert("error", errMsg)
			<form hx-post={ templ.URL("/groups/" + groupID + "/members/" + m.ID) } hx-target="#detail-content-area" hx-swap="innerHTML" class="space-y-4">
				@components.FormField(components.FormFieldProps{
					Label:    "Name",
					Type:     "text",
					Name:     "name",
					Value:    m.Name,
					Required: true,
				})
				@components.FormField(components.FormFieldProps{
					Label:    "Phone (optional)",
					Type:     "tel",
					Name:     "phone",
					Value:    stringPtrValue(m.Phone),
					Optional: true,
				})
				@components.FormField(components.FormFieldProps{
					Label:    "Email (optional)",
					Type:     "email",
					Name:     "email",
					Value:    stringPtrValue(m.Email),
					Optional: true,
				})
				<button type="submit" class="w-full font-oswald bg-pitch text-chalk hover:bg-turf py-3 rounded transition-colors text-lg mt-2">
					SAVE CHANGES
				</button>
			</form>
		</div>
	</div>
}

func stringPtrValue(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}
