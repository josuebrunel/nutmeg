package groups

import (
	"nutmeg/internal/model"
	"nutmeg/internal/repository"
	components "nutmeg/views/components"
)

templ Detail(g *model.Group, members []repository.MemberInfo, isAdmin bool, isOwner bool, ownerEmail string, joinRequests []JoinRequestEntry, leaderboard []LeaderboardEntry, matches []MatchEntry, successMsg string, errMsg string) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="stadium-gradient rounded-xl px-5 py-5 sm:px-8 sm:py-6 mb-8 flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-3">
				<h2 class="font-oswald text-2xl sm:text-4xl text-chalk font-bold">{ g.Name }</h2>
				if isAdmin {
					<a href={ templ.URL("/groups/" + g.ID + "/edit") } class="text-turf hover:text-gold transition-colors" aria-label="Edit group name">
						@components.IconEdit("size-5")
					</a>
				}
			</div>
			<div class="flex flex-wrap gap-2">
				if isOwner {
					<button class="font-oswald bg-nutmeg text-chalk px-3 py-1.5 rounded text-sm hover:bg-red-700 transition-colors flex items-center gap-1" hx-delete={ templ.URL("/groups/" + g.ID) } hx-confirm="Delete this group? This cannot be undone." hx-target="body">@components.IconTrash("size-4") Delete</button>
				}
				<button hx-get={ templ.URL("/groups/" + g.ID + "/match-modal") } hx-target="#detail-content-area" hx-swap="innerHTML" class="font-oswald bg-gold text-pitch border-2 border-gold px-3 py-1.5 rounded hover:bg-turf hover:border-turf transition-colors flex items-center gap-1 text-sm">
					@components.IconWhistle("size-4")
					Log Match
				</button>
			</div>
		</div>
		if errMsg != "" {
			<div role="alert" class="bg-error/10 text-error text-sm font-body p-3 rounded-lg mb-4">{ errMsg }</div>
		}
		if successMsg != "" {
			<div role="alert" class="bg-success/10 text-success text-sm font-body p-3 rounded-lg mb-4">{ successMsg }</div>
		}
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
			<div class="lg:col-span-5" id="detail-content-area">
				@DetailContent(g.ID, leaderboard, matches)
			</div>
			@RosterColumn(g, members, isAdmin, isOwner, ownerEmail, joinRequests)
			<div class="lg:col-span-4">
				<h3 class="font-oswald text-2xl text-pitch mb-4">RECENT MATCHES</h3>
				<div class="space-y-4">
					if len(matches) == 0 {
						<p class="text-ink/60 text-sm font-body">No matches logged yet.</p>
					} else {
						for _, m := range matches {
							<div class="ticket-stub bg-white border border-pitch/10 shadow-sm flex flex-col text-sm overflow-hidden">
								<div class="grass-stripe-accent h-1 w-full"></div>
								<div class="flex w-full">
									<div class={ "flex-1 p-3 text-center", m.WinnerClass("a") }>
										<div class="font-oswald text-xs mb-1">{ m.TeamA }</div>
										<div class="ticket-score text-2xl">{ m.ScoreA }</div>
									</div>
									<div class="ticket-perforation"></div>
									<div class={ "flex-1 p-3 text-center", m.WinnerClass("b") }>
										<div class="font-oswald text-xs mb-1">{ m.TeamB }</div>
										<div class="ticket-score text-2xl">{ m.ScoreB }</div>
									</div>
								</div>
								<div class="w-full flex items-center justify-between bg-base-200/50 p-2 border-t border-pitch/10">
									<span class="text-xs text-ink/50 font-mono">{ m.Date }</span>
									<div class="flex items-center gap-2">
										<button class="text-xs font-oswald text-turf hover:text-pitch" hx-get={ templ.URL("/groups/" + m.GroupID + "/matches/" + m.ID + "/edit") } hx-target="#detail-content-area" hx-swap="innerHTML">@components.IconEdit("size-3.5")</button>
										<button class="text-xs font-oswald text-nutmeg hover:text-pitch" hx-delete={ templ.URL("/groups/" + m.GroupID + "/matches/" + m.ID) } hx-confirm="Delete this match?" hx-target="body">@components.IconTrash("size-3.5") Remove</button>
									</div>
								</div>
							</div>
						}
					}
				</div>
			</div>
		</div>
	</div>
}

templ DetailContent(groupID string, leaderboard []LeaderboardEntry, matches []MatchEntry) {
	<div>
		<div class="flex items-center justify-between mb-4">
			<h3 class="font-oswald text-2xl text-pitch flex items-center gap-2">
				@components.IconTrophy("size-6")
				LEADERBOARD
			</h3>
			<a href={ templ.URL("/groups/" + groupID + "/leaderboard") } target="_blank" rel="noopener" class="font-oswald bg-turf text-chalk px-2.5 py-1 rounded text-xs hover:bg-pitch transition-colors flex items-center gap-1">
				@components.IconShare("size-3.5")
				Share
			</a>
		</div>
		@leaderboardTable(leaderboard)
	</div>
}

templ PublicLeaderboard(g *model.Group, leaderboard []LeaderboardEntry, joinStatus string, successMsg string, errMsg string) {
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="stadium-gradient rounded-xl px-5 py-5 sm:px-8 sm:py-6 mb-6">
			<h2 class="font-oswald text-2xl sm:text-4xl text-chalk font-bold">{ g.Name }</h2>
		</div>
		if errMsg != "" {
			<div role="alert" class="bg-error/10 text-error text-sm font-body p-3 rounded-lg mb-4">{ errMsg }</div>
		}
		if successMsg != "" {
			<div role="alert" class="bg-success/10 text-success text-sm font-body p-3 rounded-lg mb-4">{ successMsg }</div>
		}
		<h3 class="font-oswald text-2xl text-pitch mb-4 flex items-center gap-2">
			@components.IconTrophy("size-6")
			LEADERBOARD
		</h3>
		@leaderboardTable(leaderboard)
		<div class="mt-6">
			switch joinStatus {
				case "anonymous":
					<a href="/login" class="font-oswald bg-turf text-ink px-4 py-2 rounded-sm font-bold shadow hover:bg-gold transition-colors inline-block">Log in to request to join</a>
				case "owner":
				case "member":
					<span class="font-oswald text-sm text-turf">You're already a member</span>
				case "pending":
					<span class="font-oswald text-sm text-ink/60">Join request pending</span>
				default:
					<form method="post" action={ templ.URL("/groups/" + g.ID + "/join-requests") }>
						<button type="submit" class="font-oswald bg-turf text-ink px-4 py-2 rounded-sm font-bold shadow hover:bg-gold transition-colors">Request to Join</button>
					</form>
			}
		</div>
	</div>
}

templ leaderboardTable(leaderboard []LeaderboardEntry) {
	<div class="bg-white rounded-lg shadow border border-pitch/20 overflow-x-auto">
		<table class="w-full text-left border-collapse">
			<thead class="bg-pitch text-chalk font-oswald text-sm">
				<tr>
					<th class="p-3">Rnk</th>
					<th class="p-3">Player</th>
					<th class="p-3 text-center">W</th>
					<th class="p-3 text-center">L</th>
					<th class="p-3 text-center">G</th>
					<th class="p-3 text-center">A</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-pitch/10">
				if len(leaderboard) == 0 {
					<tr><td colspan="6" class="p-6 text-center text-ink/50 font-body text-sm">No match data yet.</td></tr>
				} else {
					for i, p := range leaderboard {
						<tr class="hover:bg-chalk/50 transition-colors">
							<td class="p-3 font-mono font-bold text-pitch">
								if i == 0 {
									<span class="inline-flex items-center gap-1 text-gold">
										@components.IconTrophy("size-4")
										1
									</span>
								} else {
									{ i + 1 }
								}
							</td>
							<td class="p-3 font-medium">{ p.Name }</td>
							<td class="p-3 text-center font-mono text-turf font-bold">{ p.Wins }</td>
							<td class="p-3 text-center font-mono text-nutmeg">{ p.Losses }</td>
							<td class="p-3 text-center font-mono text-ink/70">{ p.Goals }</td>
							<td class="p-3 text-center font-mono text-ink/70">{ p.Assists }</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

templ RosterColumn(g *model.Group, members []repository.MemberInfo, isAdmin bool, isOwner bool, ownerEmail string, joinRequests []JoinRequestEntry) {
	<div id="roster-column" class="lg:col-span-3">
		<h3 class="font-oswald text-2xl text-pitch mb-4 flex items-center gap-2">@components.IconJersey("size-6") ROSTER</h3>
		if isAdmin && len(joinRequests) > 0 {
			<div class="bg-white rounded-lg shadow border border-pitch/20 p-3 sm:p-4 mb-4">
				<h4 class="font-oswald text-sm text-pitch mb-2">JOIN REQUESTS</h4>
				<ul class="space-y-1">
					for _, r := range joinRequests {
						<li class="flex justify-between items-center text-sm py-1.5 border-b border-base-200 last:border-0">
							<div class="flex flex-col truncate">
								<span class="font-body truncate">{ r.Name }</span>
								<span class="text-xs text-ink/50">{ r.Email }</span>
							</div>
							<div class="flex items-center gap-2 shrink-0">
								<button class="font-oswald text-xs bg-turf text-chalk hover:bg-pitch px-2 py-1 rounded transition-colors flex items-center gap-1" hx-post={ templ.URL("/groups/" + g.ID + "/join-requests/" + r.ID + "/approve") } hx-target="#roster-column" hx-swap="outerHTML">
									@components.IconCheck("size-3.5")
									Approve
								</button>
								<button class="font-oswald text-xs bg-nutmeg text-chalk hover:bg-red-700 px-2 py-1 rounded transition-colors flex items-center gap-1" hx-post={ templ.URL("/groups/" + g.ID + "/join-requests/" + r.ID + "/reject") } hx-target="#roster-column" hx-swap="outerHTML">
									@components.IconClose("size-3.5")
									Reject
								</button>
							</div>
						</li>
					}
				</ul>
			</div>
		}
		<div class="bg-white rounded-lg shadow border border-pitch/20 p-3 sm:p-4">
			if isAdmin {
				<form hx-post={ templ.URL("/groups/" + g.ID + "/members") } hx-target="#roster-column" hx-swap="outerHTML" class="flex flex-col gap-2 mb-3">
					<input type="text" name="name" placeholder="Name(s) — comma separated" class="border-2 border-pitch rounded px-2 py-1.5 text-sm" required />
					<input type="tel" name="phone" placeholder="Phone (optional)" class="border-2 border-pitch/50 rounded px-2 py-1.5 text-sm" />
					<input type="email" name="email" placeholder="Email (optional)" class="border-2 border-pitch/50 rounded px-2 py-1.5 text-sm" />
					<button type="submit" class="bg-pitch text-chalk font-oswald text-xs px-3 py-1.5 rounded hover:bg-turf transition-colors whitespace-nowrap flex items-center justify-center gap-1">
						@components.IconPlus("size-3.5")
						Add
					</button>
				</form>
			}
			<ul class="space-y-1">
				for _, m := range members {
					<li class="flex justify-between items-center text-sm py-1.5 border-b border-base-200 last:border-0">
						<div class="flex flex-col truncate">
							<span class="font-body truncate">{ m.Name }</span>
							if m.Email != nil && *m.Email != "" {
								<span class="text-xs text-ink/50">{ *m.Email }</span>
							}
						</div>
						<div class="flex items-center gap-2 shrink-0">
							if isRosterOwner(m, ownerEmail) {
								<span class="text-xs font-oswald text-gold">Owner</span>
							}
							if isPromotedAdmin(m, ownerEmail) {
								<span class="text-xs font-oswald text-turf">Admin</span>
							}
							if isOwner && !isRosterOwner(m, ownerEmail) {
								if isPromotedAdmin(m, ownerEmail) {
									<button class="font-oswald text-xs bg-gold/20 text-pitch hover:bg-gold px-2 py-1 rounded transition-colors flex items-center gap-1" hx-post={ templ.URL("/groups/" + g.ID + "/members/" + m.ID + "/demote") } hx-target="#roster-column" hx-swap="outerHTML" hx-confirm={ "Demote " + m.Name + " to member?" }>
										@components.IconArrowDown("size-3.5")
										Demote
									</button>
								} else {
									<button class="font-oswald text-xs bg-turf/10 text-turf hover:bg-turf hover:text-chalk px-2 py-1 rounded transition-colors flex items-center gap-1" hx-post={ templ.URL("/groups/" + g.ID + "/members/" + m.ID + "/promote") } hx-target="#roster-column" hx-swap="outerHTML" hx-confirm={ "Promote " + m.Name + " to admin?" }>
										@components.IconArrowUp("size-3.5")
										Promote
									</button>
								}
							}
							if (isAdmin && m.Role != "admin") || (isOwner && isPromotedAdmin(m, ownerEmail)) {
								<button class="bg-nutmeg/10 text-nutmeg hover:bg-nutmeg hover:text-chalk p-1.5 rounded transition-colors" aria-label={ "Remove " + m.Name } hx-delete={ templ.URL("/groups/" + g.ID + "/members/" + m.ID) } hx-target="#roster-column" hx-swap="outerHTML" hx-confirm={ "Remove " + m.Name + "?" }>
									@components.IconClose("size-3.5")
								</button>
							}
						</div>
					</li>
				}
			</ul>
		</div>
	</div>
}

// isRosterOwner reports whether m is the group Owner's own roster row.
// Both the Owner and a promoted admin carry role == "admin"; the Owner's
// row is distinguished by its email matching the Owner's ezauth account.
func isRosterOwner(m repository.MemberInfo, ownerEmail string) bool {
	return m.Role == "admin" && m.Email != nil && *m.Email == ownerEmail
}

// isPromotedAdmin reports whether m is an admin row that isn't the Owner.
func isPromotedAdmin(m repository.MemberInfo, ownerEmail string) bool {
	return m.Role == "admin" && !isRosterOwner(m, ownerEmail)
}

type JoinRequestEntry struct {
	ID    string
	Name  string
	Email string
}

type LeaderboardEntry struct {
	Name    string
	Wins    int
	Losses  int
	Goals   int
	Assists int
}

type MatchEntry struct {
	ID      string
	GroupID string
	TeamA   string
	TeamB   string
	ScoreA  int
	ScoreB  int
	Date    string
}

func (m MatchEntry) WinnerClass(team string) string {
	if m.ScoreA == m.ScoreB {
		return "p-3 text-center"
	}
	if team == "a" && m.ScoreA > m.ScoreB {
		return "p-3 text-center font-bold text-turf"
	}
	if team == "b" && m.ScoreB > m.ScoreA {
		return "p-3 text-center font-bold text-turf"
	}
	return "p-3 text-center"
}
