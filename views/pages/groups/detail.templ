package groups

import (
	"fmt"
	"strings"

	"nutmeg/internal/model"
	"nutmeg/internal/repository"
	components "nutmeg/views/components"
)

templ Detail(g *model.Group, isAdmin bool, isOwner bool, tabContent templ.Component, successMsg string, errMsg string) {
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="stadium-gradient rounded-xl px-5 py-5 sm:px-8 sm:py-6 mb-8 flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-3">
				<h2 class="font-oswald text-2xl sm:text-4xl text-chalk font-bold">{ g.Name }</h2>
				if isAdmin {
					<a href={ templ.URL("/groups/" + g.ID + "/edit") } class="text-turf hover:text-gold transition-colors" aria-label="Edit group name">
						@components.IconEdit("size-5")
					</a>
				}
			</div>
			<div class="flex flex-wrap gap-2">
				if isOwner {
					<button class="font-oswald bg-nutmeg text-chalk px-3 py-1.5 rounded text-sm hover:bg-red-700 transition-colors flex items-center gap-1" hx-delete={ templ.URL("/groups/" + g.ID) } hx-confirm="Delete this group? This cannot be undone." hx-target="body">@components.IconTrash("size-4") Delete</button>
				}
				<button hx-get={ templ.URL("/groups/" + g.ID + "/match-modal") } hx-target="#detail-content-area" hx-swap="innerHTML" class="font-oswald bg-gold text-pitch border-2 border-gold px-3 py-1.5 rounded hover:bg-turf hover:border-turf transition-colors flex items-center gap-1 text-sm">
					@components.IconWhistle("size-4")
					Log Match
				</button>
			</div>
		</div>
		if errMsg != "" {
			<div role="alert" class="bg-error/10 text-error text-sm font-body p-3 rounded-lg mb-4">{ errMsg }</div>
		}
		if successMsg != "" {
			<div role="alert" class="bg-success/10 text-success text-sm font-body p-3 rounded-lg mb-4">{ successMsg }</div>
		}
		<div id="detail-content-area">
			@tabContent
		</div>
		<div id="article-panel"></div>
	</div>
}

// tabClass picks the active vs. inactive tab-button styling — same
// plain-Go-helper pattern as leaderboardRowClass below.
func tabClass(key, active string) string {
	if key == active {
		return "border-turf text-turf"
	}
	return "border-transparent text-ink/60 hover:text-pitch"
}

templ groupTabButton(groupID, path, key, active string) {
	<button
		type="button"
		hx-get={ templ.URL("/groups/" + groupID + "/" + path) }
		hx-target="#detail-content-area"
		hx-swap="innerHTML"
		class={ "px-4 py-2 font-oswald text-sm flex items-center gap-1.5 border-b-2 -mb-0.5 shrink-0 whitespace-nowrap transition-colors", tabClass(key, active) }
	>
		{ children... }
	</button>
}

// GroupTabs is the persistent Leaderboard / Roster / Recent Matches menu
// shown above whichever section is currently active — the replacement for
// the old always-visible 3-column layout. Each button takes over the whole
// #detail-content-area (tab bar included), so switching tabs re-renders the
// active-state styling along with the new section. overflow-x-auto lets the
// bar scroll horizontally on narrow phone screens instead of wrapping or
// overflowing the viewport — the three labels together are wider than a
// typical phone's content width once page padding is accounted for.
func publicTabClass(key, active string) string {
	if key == active {
		return "border-turf text-turf"
	}
	return "border-transparent text-ink/60 hover:text-pitch"
}

templ publicTabButton(key, active, target string) {
	<button
		type="button"
		class={ "public-tab-btn px-4 py-2 font-oswald text-sm flex items-center gap-1.5 border-b-2 -mb-0.5 shrink-0 whitespace-nowrap transition-colors", publicTabClass(key, active) }
		data-target={ target }
	>
		{ children... }
	</button>
}

// PublicGroupTabs is the public leaderboard page's Leaderboard / Recent
// Matches menu — visually matching GroupTabs, but a pure client-side
// show/hide (static/js/main.js) rather than an HTMX swap, since both
// panels are already fully rendered in the same response and there's no
// #detail-content-area on this page to swap into.
templ PublicGroupTabs(active string) {
	<div class="flex gap-1 mb-6 border-b-2 border-pitch/10 overflow-x-auto">
		@publicTabButton("leaderboard", active, "#public-panel-leaderboard") {
			@components.IconTrophy("size-4")
			LEADERBOARD
		}
		@publicTabButton("matches", active, "#public-panel-matches") {
			@components.IconMatch("size-4")
			RECENT MATCHES
		}
		@publicTabButton("news", active, "#public-panel-news") {
			@components.IconWhistle("size-4")
			NEWS
		}
	</div>
}

templ GroupTabs(groupID string, active string) {
	<div class="flex gap-1 mb-6 border-b-2 border-pitch/10 overflow-x-auto">
		@groupTabButton(groupID, "leaderboard-full", "leaderboard", active) {
			@components.IconTrophy("size-4")
			LEADERBOARD
		}
		@groupTabButton(groupID, "roster-full", "roster", active) {
			@components.IconJersey("size-4")
			ROSTER
		}
		@groupTabButton(groupID, "matches-full", "matches", active) {
			@components.IconMatch("size-4")
			RECENT MATCHES
		}
		@groupTabButton(groupID, "news-full", "news", active) {
			@components.IconWhistle("size-4")
			NEWS
		}
	</div>
}

templ LeaderboardTab(groupID string, sortBy string, leaderboard []LeaderboardEntry, news []NewsEntry) {
	@GroupTabs(groupID, "leaderboard")
	@LeaderboardSection(groupID, sortBy, leaderboard, true)
	@NewsFeed(groupID, news)
}

templ RosterTab(g *model.Group, members []repository.MemberInfo, isAdmin bool, isOwner bool, ownerEmail string, joinRequests []JoinRequestEntry, news []NewsEntry) {
	@GroupTabs(g.ID, "roster")
	@RosterColumn(g, members, isAdmin, isOwner, ownerEmail, joinRequests, true)
	@NewsFeed(g.ID, news)
}

templ MatchesTab(groupID string, matches []MatchEntry, news []NewsEntry) {
	@GroupTabs(groupID, "matches")
	@RecentMatchesColumn(groupID, matches, true)
	@NewsFeed(groupID, news)
}

templ NewsTab(groupID string, news []NewsEntry) {
	@GroupTabs(groupID, "news")
	if len(news) == 0 {
		<h3 class="font-oswald text-2xl text-pitch mb-4 flex items-center gap-2">
			@components.IconWhistle("size-6")
			NEWS
		</h3>
		<p class="font-body text-ink/60 text-sm py-8 text-center">No news yet — check back after the next match.</p>
	} else {
		@NewsFeed(groupID, news)
	}
}

// widthClass picks between a section's normal grid column span (now unused
// by the tabbed private group page, which always renders fullWidth=true,
// but still relevant if a section is ever embedded non-full elsewhere) and
// a centered full-width wrapper.
func widthClass(fullWidth bool, colSpanClass, fullClass string) string {
	if fullWidth {
		return fullClass
	}
	return colSpanClass
}

templ LeaderboardSection(groupID string, sortBy string, leaderboard []LeaderboardEntry, fullWidth bool) {
	<div class={ widthClass(fullWidth, "lg:col-span-5", "w-full") }>
		<div class="flex items-center justify-between mb-4">
			<h3 class="font-oswald text-2xl text-pitch flex items-center gap-2">
				@components.IconTrophy("size-6")
				LEADERBOARD
			</h3>
			<a href={ templ.URL("/groups/" + groupID + "/leaderboard") } target="_blank" rel="noopener" class="font-oswald bg-turf text-chalk px-2.5 py-1 rounded text-xs hover:bg-pitch transition-colors flex items-center gap-1">
				@components.IconShare("size-3.5")
				Share
			</a>
		</div>
		if fullWidth {
			<input type="text" class="leaderboard-search w-full border-2 border-pitch/20 rounded px-3 py-2 text-sm mb-3" placeholder="Search players…" aria-label="Search players"/>
		}
		@leaderboardTable(groupID, "/groups/"+groupID, leaderboard, sortBy, leaderboardLimit(fullWidth, len(leaderboard)), leaderboardShowAllURL(fullWidth, groupID, sortBy))
	</div>
}

func leaderboardLimit(fullWidth bool, total int) int {
	if fullWidth {
		return total
	}
	return defaultVisibleLimit
}

// leaderboardShowAllURL returns the HTMX full-width-takeover URL for the
// private group page's "Show all" link, or "" for the public leaderboard
// page (fullWidth is always false there too, but it has no #detail-content-area
// to swap into, so leaderboardTable falls back to its in-place JS reveal).
func leaderboardShowAllURL(fullWidth bool, groupID, sortBy string) string {
	if fullWidth {
		return ""
	}
	url := "/groups/" + groupID + "/leaderboard-full"
	if sortBy != "" {
		url += "?sort=" + sortBy
	}
	return url
}

templ RecentMatchesColumn(groupID string, matches []MatchEntry, fullWidth bool) {
	<div class={ widthClass(fullWidth, "lg:col-span-4", "w-full") }>
		<h3 class="font-oswald text-2xl text-pitch mb-4">RECENT MATCHES</h3>
		<div class="space-y-4">
			if len(matches) == 0 {
				<p class="text-ink/60 text-sm font-body">No matches logged yet.</p>
			} else {
				for _, m := range visibleMatches(matches, fullWidth) {
					<div class="ticket-stub bg-white border border-pitch/10 shadow-sm flex flex-col text-sm overflow-hidden">
						<div class="grass-stripe-accent h-1 w-full"></div>
						<div
							class="flex w-full cursor-pointer hover:opacity-90 transition-opacity"
							hx-get={ templ.URL("/groups/" + m.GroupID + "/matches/" + m.ID) }
							hx-target="#article-panel"
							hx-swap="innerHTML"
							hx-push-url="true"
						>
							<div class={ "flex-1 p-3 text-center", m.WinnerClass("a") }>
								<div class="font-oswald text-xs mb-1">{ m.TeamA }</div>
								<div class="ticket-score text-2xl">{ m.ScoreA }</div>
							</div>
							<div class="ticket-perforation"></div>
							<div class={ "flex-1 p-3 text-center", m.WinnerClass("b") }>
								<div class="font-oswald text-xs mb-1">{ m.TeamB }</div>
								<div class="ticket-score text-2xl">{ m.ScoreB }</div>
							</div>
						</div>
						<div class="w-full flex items-center justify-between bg-base-200/50 p-2 border-t border-pitch/10">
							<span class="text-xs text-ink/50 font-mono">{ m.Date }</span>
							<div class="flex items-center gap-2">
								<form method="POST" action={ templ.URL("/groups/" + m.GroupID + "/matches/" + m.ID + "/regenerate-article") }>
									<button type="submit" class="text-xs font-oswald text-turf hover:text-pitch">Regenerate article</button>
								</form>
								<button class="text-xs font-oswald text-turf hover:text-pitch" hx-get={ templ.URL("/groups/" + m.GroupID + "/matches/" + m.ID + "/edit") } hx-target="#detail-content-area" hx-swap="innerHTML">@components.IconEdit("size-3.5")</button>
								<button class="text-xs font-oswald text-nutmeg hover:text-pitch" hx-delete={ templ.URL("/groups/" + m.GroupID + "/matches/" + m.ID) } hx-confirm="Delete this match?" hx-target="body">@components.IconTrash("size-3.5") Remove</button>
							</div>
						</div>
					</div>
				}
				if !fullWidth && len(matches) > defaultVisibleLimit {
					<div class="text-center">
						<button type="button" class="text-xs font-oswald text-turf hover:text-pitch underline" hx-get={ templ.URL("/groups/" + groupID + "/matches-full") } hx-target="#detail-content-area" hx-swap="innerHTML">
							Show all ({ len(matches) - defaultVisibleLimit } more)
						</button>
					</div>
				}
			}
		</div>
	</div>
}

// visibleMatches returns the full slice when fullWidth (the "Show all" view
// re-fetches and renders everything), or the first defaultVisibleLimit
// entries otherwise.
func visibleMatches(matches []MatchEntry, fullWidth bool) []MatchEntry {
	if fullWidth || len(matches) <= defaultVisibleLimit {
		return matches
	}
	return matches[:defaultVisibleLimit]
}

// PublicRecentMatchesColumn is the public leaderboard page's read-only
// Recent Matches section — same MatchEntry/WinnerClass rendering as
// RecentMatchesColumn, but with no Edit/Remove buttons (those stay
// admin-only) and the whole card is clickable to reveal that match's AI
// news article. Uses the same client-side JS "Show all" reveal as the
// public leaderboard table (no #detail-content-area to swap into here).
templ PublicRecentMatchesColumn(groupID string, matches []MatchEntry) {
	<div class="mt-8">
		<h3 class="font-oswald text-2xl text-pitch mb-4">RECENT MATCHES</h3>
		<div class="space-y-4">
			if len(matches) == 0 {
				<p class="text-ink/60 text-sm font-body">No matches logged yet.</p>
			} else {
				for i, m := range matches {
					<div
						class={ "ticket-stub bg-white border border-pitch/10 shadow-sm flex flex-col text-sm overflow-hidden cursor-pointer hover:shadow-md transition-shadow", extraRowClass(i, defaultVisibleLimit, "public-matches-extra") }
						hx-get={ templ.URL("/groups/" + m.GroupID + "/matches/" + m.ID) }
						hx-target="#article-panel"
						hx-swap="innerHTML"
						hx-push-url="true"
					>
						<div class="grass-stripe-accent h-1 w-full"></div>
						<div class="flex w-full">
							<div class={ "flex-1 p-3 text-center", m.WinnerClass("a") }>
								<div class="font-oswald text-xs mb-1">{ m.TeamA }</div>
								<div class="ticket-score text-2xl">{ m.ScoreA }</div>
							</div>
							<div class="ticket-perforation"></div>
							<div class={ "flex-1 p-3 text-center", m.WinnerClass("b") }>
								<div class="font-oswald text-xs mb-1">{ m.TeamB }</div>
								<div class="ticket-score text-2xl">{ m.ScoreB }</div>
							</div>
						</div>
						<div class="w-full flex items-center justify-between bg-base-200/50 p-2 border-t border-pitch/10">
							<span class="text-xs text-ink/50 font-mono">{ m.Date }</span>
							<span class="text-xs font-oswald text-turf flex items-center gap-1">
								<iconify-icon icon="mdi:newspaper" class="w-[1em] h-[1em]"></iconify-icon>
								Read report
							</span>
						</div>
					</div>
				}
				if len(matches) > defaultVisibleLimit {
					<div class="text-center">
						<button type="button" class="show-more-btn text-xs font-oswald text-turf hover:text-pitch underline" data-target=".public-matches-extra">
							Show all ({ len(matches) - defaultVisibleLimit } more)
						</button>
					</div>
				}
			}
		</div>
	</div>
}

templ PublicLeaderboard(g *model.Group, leaderboard []LeaderboardEntry, matches []MatchEntry, news []NewsEntry, joinStatus string, sortBy string, successMsg string, errMsg string) {
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="stadium-gradient rounded-xl px-5 py-5 sm:px-8 sm:py-6 mb-6 flex items-start justify-between gap-4">
			<h2 class="font-oswald text-2xl sm:text-4xl text-chalk font-bold">{ g.Name }</h2>
			@components.ShareWidget(g.Name + " — Leaderboard on Nutmeg")
		</div>
		if errMsg != "" {
			<div role="alert" class="bg-error/10 text-error text-sm font-body p-3 rounded-lg mb-4">{ errMsg }</div>
		}
		if successMsg != "" {
			<div role="alert" class="bg-success/10 text-success text-sm font-body p-3 rounded-lg mb-4">{ successMsg }</div>
		}
		@PublicGroupTabs("leaderboard")
		<div id="public-panel-leaderboard" class="public-tab-panel">
			<h3 class="font-oswald text-2xl text-pitch mb-4 flex items-center gap-2">
				@components.IconTrophy("size-6")
				LEADERBOARD
			</h3>
			@leaderboardTable(g.ID, "/groups/"+g.ID+"/leaderboard", leaderboard, sortBy, defaultVisibleLimit, "")
		</div>
		<div id="public-panel-matches" class="public-tab-panel hidden">
			@PublicRecentMatchesColumn(g.ID, matches)
		</div>
		<div id="public-panel-news" class="public-tab-panel hidden">
			if len(news) == 0 {
				<h3 class="font-oswald text-2xl text-pitch mb-4 flex items-center gap-2">
					@components.IconWhistle("size-6")
					NEWS
				</h3>
				<p class="font-body text-ink/60 text-sm py-8 text-center">No news yet — check back after the next match.</p>
			} else {
				@NewsFeed(g.ID, news)
			}
		</div>
		<div class="mt-6">
			switch joinStatus {
				case "anonymous":
					<a href="/login" class="font-oswald bg-turf text-ink px-4 py-2 rounded-sm font-bold shadow hover:bg-gold transition-colors inline-block">Log in to request to join</a>
				case "owner":
				case "member":
					<span class="font-oswald text-sm text-turf">You're already a member</span>
				case "pending":
					<span class="font-oswald text-sm text-ink/60">Join request pending</span>
				default:
					<form method="post" action={ templ.URL("/groups/" + g.ID + "/join-requests") }>
						<button type="submit" class="font-oswald bg-turf text-ink px-4 py-2 rounded-sm font-bold shadow hover:bg-gold transition-colors">Request to Join</button>
					</form>
			}
		</div>
	</div>
	<div id="article-panel"></div>
}

// scoreCellClass mutes an unqualified player's score cell — it's still
// shown (never hidden, always transparent about the real number), just
// visually marked as provisional since it isn't what determined their
// current position (they're ranked by wins until they qualify).
func scoreCellClass(qualified bool) string {
	if qualified {
		return "text-ink/70"
	}
	return "text-ink/30"
}

func scoreCellTitle(qualified bool) string {
	if qualified {
		return ""
	}
	return "Ranked by wins until 3 matches played"
}

// defaultVisibleLimit caps how many rows the Leaderboard, Roster, and Recent
// Matches sections render visibly by default — large imported rosters (e.g.
// a CSV import) can easily run into the dozens, and showing all of them at
// once turns the group page into an endless scroll.
const defaultVisibleLimit = 10

// extraRowClass hides rows beyond defaultVisibleLimit and tags them with a
// marker class so the "Show all" button's click handler (static/js/main.js)
// can find exactly the rows it should reveal.
func extraRowClass(index, limit int, marker string) string {
	if index >= limit {
		return "hidden " + marker
	}
	return ""
}

// leaderboardTable renders up to `limit` rows. If showAllURL is set (the
// private group page), "Show all" is an HTMX link that takes over
// #detail-content-area with the complete list (GroupHandler.LeaderboardFull).
// If showAllURL is empty (the public leaderboard page, which has no
// #detail-content-area to swap into), all rows are rendered up front and
// "Show all" just reveals the hidden ones client-side (static/js/main.js).
templ leaderboardTable(groupID string, sortBaseURL string, leaderboard []LeaderboardEntry, activeSort string, limit int, showAllURL string) {
	<div class="bg-white rounded-lg shadow border border-pitch/20 overflow-x-auto score-info-group">
		<div class="flex items-center gap-3 px-3 pt-3 pb-1 text-xs font-oswald text-ink/50">
			<span>Sort:</span>
			@sortLink(sortBaseURL, "", "Score", activeSort)
			<button type="button" class="score-info-btn normal-case font-body text-ink/40 hover:text-ink/70" aria-label="How ranking works" aria-expanded="false">&#9432;</button>
			@sortLink(sortBaseURL, "goals", "Goals", activeSort)
			@sortLink(sortBaseURL, "assists", "Assists", activeSort)
			@sortLink(sortBaseURL, "clean_sheets", "Clean Sheets", activeSort)
			@sortLink(sortBaseURL, "matches", "Matches", activeSort)
		</div>
		<p class="score-info-text hidden px-3 pb-2 text-xs font-body text-ink/60 normal-case">{ components.ScoreExplainer }</p>
		<table class="w-full text-left border-collapse">
			<thead class="bg-pitch text-chalk font-oswald text-sm">
				<tr>
					<th class="p-3">Rnk</th>
					<th class="p-3">Player</th>
					<th class="p-3 text-center">MP</th>
					<th class="p-3 text-center">W</th>
					<th class="p-3 text-center">D</th>
					<th class="p-3 text-center">L</th>
					<th class="p-3 text-center">G</th>
					<th class="p-3 text-center">A</th>
					<th class="p-3 text-center">CS</th>
					<th class="p-3 text-center">PTS/G</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-pitch/10">
				if len(leaderboard) == 0 {
					<tr><td colspan="10" class="p-6 text-center text-ink/50 font-body text-sm">No match data yet.</td></tr>
				} else {
					for i, p := range visibleLeaderboardRows(leaderboard, limit, showAllURL) {
						<tr class={ "hover:bg-chalk/50 transition-colors", leaderboardRowClass(i, limit, showAllURL) } data-player-name={ strings.ToLower(p.Name) }>
							<td class="p-3 font-mono font-bold text-pitch">
								if i == 0 {
									<span class="text-gold" title="Rank 1">
										@rankOneIcon(activeSort)
									</span>
								} else {
									{ i + 1 }
								}
							</td>
							<td class="p-3 font-medium">
								<a href={ templ.URL("/groups/" + groupID + "/players/" + p.ID) } class="hover:text-turf hover:underline">{ p.Name }</a>
								if p.Position != "" {
									<span class="text-[10px] font-oswald text-turf bg-turf/10 rounded px-1 py-0.5 ml-1">{ p.Position }</span>
								}
							</td>
							<td class="p-3 text-center font-mono text-ink/70">{ p.Matches }</td>
							<td class="p-3 text-center font-mono text-turf font-bold">{ p.Wins }</td>
							<td class="p-3 text-center font-mono text-ink/50">{ p.Draws }</td>
							<td class="p-3 text-center font-mono text-nutmeg">{ p.Losses }</td>
							<td class="p-3 text-center font-mono text-ink/70">{ p.Goals }</td>
							<td class="p-3 text-center font-mono text-ink/70">{ p.Assists }</td>
							<td class="p-3 text-center font-mono text-ink/70">{ p.CleanSheets }</td>
							<td class={ "p-3 text-center font-mono", scoreCellClass(p.Qualified) } title={ scoreCellTitle(p.Qualified) }>
								{ fmt.Sprintf("%.2f", p.Score) }
							</td>
						</tr>
					}
					if len(leaderboard) > limit {
						<tr class="show-more-row">
							<td colspan="10" class="p-2 text-center">
								if showAllURL != "" {
									<button type="button" class="text-xs font-oswald text-turf hover:text-pitch underline" hx-get={ templ.URL(showAllURL) } hx-target="#detail-content-area" hx-swap="innerHTML">
										Show all ({ len(leaderboard) - limit } more)
									</button>
								} else {
									<button type="button" class="show-more-btn text-xs font-oswald text-turf hover:text-pitch underline" data-target=".leaderboard-extra">
										Show all ({ len(leaderboard) - limit } more)
									</button>
								}
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// rankOneIcon reflects what rank #1 actually means under the table's
// current sort — a ball when ranked by Goals, a cleat when ranked by
// Assists, and the trophy otherwise (Wins/Matches/default). Sized in em so
// it always matches the surrounding row text instead of a fixed rem size —
// components.IconGoal/IconBoot/IconTrophy hardcode "size-5" as their
// default, which wins the cascade over any caller-supplied size class.
templ rankOneIcon(activeSort string) {
	switch activeSort {
		case "goals":
			<iconify-icon icon="mdi:soccer" class="w-[1em] h-[1em] align-middle"></iconify-icon>
		case "assists":
			<iconify-icon icon="mdi:shoe-cleat" class="w-[1em] h-[1em] align-middle"></iconify-icon>
		default:
			<iconify-icon icon="mdi:trophy" class="w-[1em] h-[1em] align-middle"></iconify-icon>
	}
}

// visibleLeaderboardRows returns every row in JS-fallback mode (showAllURL
// == "", so hidden extras must still be in the DOM to reveal), or the first
// `limit` rows when an HTMX showAllURL will re-fetch the rest on demand.
func visibleLeaderboardRows(leaderboard []LeaderboardEntry, limit int, showAllURL string) []LeaderboardEntry {
	if showAllURL == "" || limit >= len(leaderboard) {
		return leaderboard
	}
	return leaderboard[:limit]
}

func leaderboardRowClass(i, limit int, showAllURL string) string {
	if showAllURL == "" {
		return extraRowClass(i, limit, "leaderboard-extra")
	}
	return ""
}

templ sortLink(baseURL, sortKey, label, activeSort string) {
	<a href={ templ.URL(sortLinkHref(baseURL, sortKey)) } class={ sortLinkClass(sortKey, activeSort) }>{ label }</a>
}

// sortLinkHref builds the leaderboard sort link — the default "Wins" sort
// omits the ?sort param entirely so it matches the table's default ORDER BY.
func sortLinkHref(baseURL, sortKey string) string {
	if sortKey == "" {
		return baseURL
	}
	return baseURL + "?sort=" + sortKey
}

func sortLinkClass(sortKey, activeSort string) string {
	if sortKey == activeSort {
		return "font-bold text-turf underline"
	}
	return "hover:text-turf"
}

templ RosterColumn(g *model.Group, members []repository.MemberInfo, isAdmin bool, isOwner bool, ownerEmail string, joinRequests []JoinRequestEntry, fullWidth bool) {
	<div id="roster-column" class={ widthClass(fullWidth, "lg:col-span-3", "w-full") }>
		<h3 class="font-oswald text-2xl text-pitch mb-4 flex items-center gap-2">@components.IconJersey("size-6") ROSTER</h3>
		if isAdmin && len(joinRequests) > 0 {
			<div class="bg-white rounded-lg shadow border border-pitch/20 p-3 sm:p-4 mb-4">
				<h4 class="font-oswald text-sm text-pitch mb-2">JOIN REQUESTS</h4>
				<ul class="space-y-1">
					for _, r := range joinRequests {
						<li class="flex justify-between items-center text-sm py-1.5 border-b border-base-200 last:border-0">
							<div class="flex flex-col truncate">
								<span class="font-body truncate">{ r.Name }</span>
								<span class="text-xs text-ink/50">{ r.Email }</span>
							</div>
							<div class="flex items-center gap-2 shrink-0">
								<button class="font-oswald text-xs bg-turf text-chalk hover:bg-pitch px-2 py-1 rounded transition-colors flex items-center gap-1" hx-post={ templ.URL("/groups/" + g.ID + "/join-requests/" + r.ID + "/approve" + viewParam(fullWidth)) } hx-target="#roster-column" hx-swap="outerHTML">
									@components.IconCheck("size-3.5")
									Approve
								</button>
								<button class="font-oswald text-xs bg-nutmeg text-chalk hover:bg-red-700 px-2 py-1 rounded transition-colors flex items-center gap-1" hx-post={ templ.URL("/groups/" + g.ID + "/join-requests/" + r.ID + "/reject" + viewParam(fullWidth)) } hx-target="#roster-column" hx-swap="outerHTML">
									@components.IconClose("size-3.5")
									Reject
								</button>
							</div>
						</li>
					}
				</ul>
			</div>
		}
		<div class="bg-white rounded-lg shadow border border-pitch/20 p-3 sm:p-4">
			if isAdmin {
				<form hx-post={ templ.URL("/groups/" + g.ID + "/members" + viewParam(fullWidth)) } hx-target="#roster-column" hx-swap="outerHTML" class="flex flex-col gap-2 mb-3">
					<input type="text" name="name" placeholder="Name(s) — comma separated" class="border-2 border-pitch rounded px-2 py-1.5 text-sm" required />
					<input type="tel" name="phone" placeholder="Phone (optional)" class="border-2 border-pitch/50 rounded px-2 py-1.5 text-sm" />
					<input type="email" name="email" placeholder="Email (optional)" class="border-2 border-pitch/50 rounded px-2 py-1.5 text-sm" />
					<select name="position" class="border-2 border-pitch/50 rounded px-2 py-1.5 text-sm">
						for _, p := range components.PlayerPositions {
							<option value={ p.Value } if p.Value == model.PositionM { selected }>{ p.Label }</option>
						}
					</select>
					<button type="submit" class="bg-pitch text-chalk font-oswald text-xs px-3 py-1.5 rounded hover:bg-turf transition-colors whitespace-nowrap flex items-center justify-center gap-1">
						@components.IconPlus("size-3.5")
						Add
					</button>
				</form>
				<form hx-post={ templ.URL("/groups/" + g.ID + "/members/import" + viewParam(fullWidth)) } hx-target="#roster-column" hx-swap="outerHTML" hx-encoding="multipart/form-data" enctype="multipart/form-data" class="flex items-center gap-2 mt-2 pt-2 border-t border-base-200">
					<input type="file" name="csv" accept=".csv" required class="text-xs flex-1 min-w-0" />
					<button type="submit" class="bg-turf text-chalk font-oswald text-xs px-3 py-1.5 rounded hover:bg-pitch transition-colors whitespace-nowrap">Import CSV</button>
				</form>
				<p class="text-xs text-ink/40 mt-1">CSV needs a header row: name (required), phone, email, position (optional)</p>
			}
			if fullWidth {
				<input type="text" class="roster-search w-full border-2 border-pitch/20 rounded px-3 py-2 text-sm mb-3" placeholder="Search players…" aria-label="Search players"/>
			}
			<div class="overflow-x-auto">
				<table class="w-full text-left border-collapse">
					<thead class="bg-pitch text-chalk font-oswald text-sm">
						<tr>
							<th class="p-2">Player</th>
							<th class="p-2">Position</th>
							<th class="p-2">Role</th>
							<th class="p-2 text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-pitch/10">
						for _, m := range visibleMembers(members, fullWidth) {
							@RosterRow(g, m, isAdmin, isOwner, ownerEmail, fullWidth)
						}
						if !fullWidth && len(members) > defaultVisibleLimit {
							<tr>
								<td colspan="4" class="text-center py-1.5">
									<button type="button" class="text-xs font-oswald text-turf hover:text-pitch underline" hx-get={ templ.URL("/groups/" + g.ID + "/roster-full") } hx-target="#detail-content-area" hx-swap="innerHTML">
										Show all ({ len(members) - defaultVisibleLimit } more)
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

// RosterRow renders one roster member's <tr> — extracted out of
// RosterColumn's loop so it's also independently swappable: the position
// picker and Promote/Demote buttons below target "closest tr" and the
// handler re-renders just this component, rather than the whole
// (potentially long) roster table, which is what was causing the page to
// jump on every tap (see GroupHandler.respondRosterRow).
templ RosterRow(g *model.Group, m repository.MemberInfo, isAdmin bool, isOwner bool, ownerEmail string, fullWidth bool) {
	<tr class="text-sm" data-player-name={ strings.ToLower(m.Name) }>
		<td class="p-2">
			<div class="flex flex-col truncate">
				<span class="font-body truncate">{ m.Name }</span>
				if m.Email != nil && *m.Email != "" {
					<span class="text-xs text-ink/50">{ *m.Email }</span>
				}
			</div>
		</td>
		<td class="p-2">
			if isAdmin {
				<div class="inline-flex rounded overflow-hidden border border-pitch/20 text-[9px] font-oswald leading-none">
					for _, p := range components.PlayerPositions {
						<button
							type="button"
							class={ positionPillClass(p.Value, stringPtrValue(m.Position)) }
							aria-label={ "Set " + m.Name + "'s position to " + p.Label }
							hx-post={ templ.URL("/groups/" + g.ID + "/members/" + m.ID + "/position/" + p.Value + viewParam(fullWidth)) }
							hx-target="closest tr"
							hx-swap="outerHTML show:none"
						>{ p.Value }</button>
					}
				</div>
			} else if m.Position != nil && *m.Position != "" {
				<span class="text-[10px] font-oswald text-turf bg-turf/10 rounded px-1 py-0.5">{ *m.Position }</span>
			}
		</td>
		<td class="p-2">
			if isRosterOwner(m, ownerEmail) {
				<span class="text-xs font-oswald text-gold">Owner</span>
			} else if isPromotedAdmin(m, ownerEmail) {
				<span class="text-xs font-oswald text-turf">Admin</span>
			}
		</td>
		<td class="p-2">
			<div class="flex items-center justify-end gap-2">
				if isOwner && !isRosterOwner(m, ownerEmail) {
					if isPromotedAdmin(m, ownerEmail) {
						<button class="bg-gold/20 text-pitch hover:bg-gold p-1.5 rounded transition-colors" aria-label={ "Demote " + m.Name + " to member" } hx-post={ templ.URL("/groups/" + g.ID + "/members/" + m.ID + "/demote" + viewParam(fullWidth)) } hx-target="closest tr" hx-swap="outerHTML show:none" hx-confirm={ "Demote " + m.Name + " to member?" }>
							@components.IconArrowDown("size-3.5")
						</button>
					} else {
						<button class="bg-turf/10 text-turf hover:bg-turf hover:text-chalk p-1.5 rounded transition-colors" aria-label={ "Promote " + m.Name + " to admin" } hx-post={ templ.URL("/groups/" + g.ID + "/members/" + m.ID + "/promote" + viewParam(fullWidth)) } hx-target="closest tr" hx-swap="outerHTML show:none" hx-confirm={ "Promote " + m.Name + " to admin?" }>
							@components.IconArrowUp("size-3.5")
						</button>
					}
				}
				if isAdmin {
					<button class="text-turf hover:text-pitch p-1.5 rounded transition-colors" aria-label={ "Edit " + m.Name } hx-get={ templ.URL("/groups/" + g.ID + "/members/" + m.ID + "/edit") } hx-target="#detail-content-area" hx-swap="innerHTML">
						@components.IconEdit("size-3.5")
					</button>
				}
				if (isAdmin && m.Role != "admin") || (isOwner && isPromotedAdmin(m, ownerEmail)) {
					<button class="bg-nutmeg/10 text-nutmeg hover:bg-nutmeg hover:text-chalk p-1.5 rounded transition-colors" aria-label={ "Remove " + m.Name } hx-delete={ templ.URL("/groups/" + g.ID + "/members/" + m.ID + viewParam(fullWidth)) } hx-target="#roster-column" hx-swap="outerHTML" hx-confirm={ "Remove " + m.Name + "?" }>
						@components.IconClose("size-3.5")
					</button>
				}
			</div>
		</td>
	</tr>
}

// positionPillClass highlights the active pill in a roster row's inline
// position picker — filled for the currently-set code, muted-but-tappable
// for the other three.
func positionPillClass(code, active string) string {
	if code == active {
		return "px-1.5 py-1 bg-turf text-chalk transition-colors"
	}
	return "px-1.5 py-1 text-ink/40 hover:bg-turf/10 hover:text-turf transition-colors"
}

// viewParam appends ?view=full to a roster-mutation URL when the roster is
// currently showing its full-width "Show all" view, so the mutation's
// response (GroupHandler.rosterWithToast) re-renders in the same mode
// instead of snapping back to the narrow, truncated grid column.
func viewParam(fullWidth bool) string {
	if fullWidth {
		return "?view=full"
	}
	return ""
}

// visibleMembers returns every member for the full-width "Show all" view,
// or the first defaultVisibleLimit otherwise.
func visibleMembers(members []repository.MemberInfo, fullWidth bool) []repository.MemberInfo {
	if fullWidth || len(members) <= defaultVisibleLimit {
		return members
	}
	return members[:defaultVisibleLimit]
}

// isRosterOwner reports whether m is the group Owner's own roster row.
// Both the Owner and a promoted admin carry role == "admin"; the Owner's
// row is distinguished by its email matching the Owner's ezauth account.
func isRosterOwner(m repository.MemberInfo, ownerEmail string) bool {
	return m.Role == "admin" && m.Email != nil && *m.Email == ownerEmail
}

// isPromotedAdmin reports whether m is an admin row that isn't the Owner.
func isPromotedAdmin(m repository.MemberInfo, ownerEmail string) bool {
	return m.Role == "admin" && !isRosterOwner(m, ownerEmail)
}

type JoinRequestEntry struct {
	ID    string
	Name  string
	Email string
}

type LeaderboardEntry struct {
	ID          string
	Name        string
	Position    string
	Matches     int
	Wins        int
	Draws       int
	Losses      int
	Goals       int
	Assists     int
	CleanSheets int
	Score       float64
	Qualified   bool
}

type MatchEntry struct {
	ID      string
	GroupID string
	TeamA   string
	TeamB   string
	ScoreA  int
	ScoreB  int
	Date    string
}

func (m MatchEntry) WinnerClass(team string) string {
	if m.ScoreA == m.ScoreB {
		return "p-3 text-center"
	}
	if team == "a" && m.ScoreA > m.ScoreB {
		return "p-3 text-center font-bold text-turf"
	}
	if team == "b" && m.ScoreB > m.ScoreA {
		return "p-3 text-center font-bold text-turf"
	}
	return "p-3 text-center"
}
