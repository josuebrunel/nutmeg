package players

import (
	"nutmeg/internal/model"
	"nutmeg/internal/repository"
	components "nutmeg/views/components"
)

templ Profile(g *model.Group, player *model.GroupPlayer, stats *repository.PlayerStats, commentary *string, chartData ChartData, canEdit bool, successMsg string, errMsg string) {
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
		<div class="stadium-gradient rounded-xl px-5 py-5 sm:px-8 sm:py-6 mb-8 flex items-start justify-between gap-4">
			<div>
				<a href={ templ.URL("/groups/" + g.PublicPath() + "/leaderboard") } class="text-turf hover:text-gold text-sm font-oswald">&larr; { g.Name } Leaderboard</a>
				<h2 class="font-oswald text-3xl sm:text-4xl text-chalk font-bold mt-2">{ player.Name }</h2>
			</div>
			@components.ShareWidget(player.Name + " on " + g.Name + " — Nutmeg")
		</div>
		if errMsg != "" {
			<div role="alert" class="bg-error/10 text-error text-sm font-body p-3 rounded-lg mb-4">{ errMsg }</div>
		}
		if successMsg != "" {
			<div role="alert" class="bg-success/10 text-success text-sm font-body p-3 rounded-lg mb-4">{ successMsg }</div>
		}
		if commentary != nil {
			<div class="bg-pitch text-chalk p-5 rounded-xl shadow border-2 border-gold mb-6">
				<div class="flex items-center gap-2 mb-2 text-gold text-xs font-oswald tracking-widest">
					@components.IconWhistle("size-4")
					THE ROAST
				</div>
				<p class="font-body italic text-chalk/90">{ *commentary }</p>
				if canEdit {
					<form method="POST" action={ templ.URL("/groups/" + g.ID + "/players/" + player.ID + "/regenerate-commentary") } class="mt-3">
						<button type="submit" class="text-xs font-oswald text-turf hover:text-gold underline">Regenerate</button>
					</form>
				}
			</div>
		} else if canEdit {
			<div class="bg-white p-5 rounded-xl shadow border border-pitch/10 mb-6 text-center">
				<p class="text-sm text-ink/50 font-body mb-2">No roast yet — one gets generated automatically after their next match.</p>
				<form method="POST" action={ templ.URL("/groups/" + g.ID + "/players/" + player.ID + "/regenerate-commentary") }>
					<button type="submit" class="text-xs font-oswald text-turf hover:text-pitch underline">Generate now</button>
				</form>
			</div>
		}
		<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
			<div class="bg-white p-4 rounded shadow border border-pitch/10 text-center">
				<div class="flex justify-center mb-1">@components.IconMatch("size-5 text-pitch")</div>
				<div class="text-sm font-oswald text-ink/70">Matches Played</div>
				<div class="text-3xl font-bold text-pitch font-mono">{ stats.MatchesPlayed }</div>
			</div>
			<div class="bg-white p-4 rounded shadow border border-pitch/10 text-center">
				<div class="flex justify-center mb-1">@components.IconTrophy("size-5 text-gold")</div>
				<div class="text-sm font-oswald text-ink/70">Wins</div>
				<div class="text-3xl font-bold text-turf font-mono">{ stats.Wins }</div>
			</div>
			<div class="bg-white p-4 rounded shadow border border-pitch/10 text-center">
				<div class="flex justify-center mb-1">@components.IconMatch("size-5 text-ink/50")</div>
				<div class="text-sm font-oswald text-ink/70">Draws</div>
				<div class="text-3xl font-bold text-pitch font-mono">{ stats.Draws }</div>
			</div>
			<div class="bg-white p-4 rounded shadow border border-pitch/10 text-center">
				<div class="flex justify-center mb-1">@components.IconClose("size-5 text-nutmeg")</div>
				<div class="text-sm font-oswald text-ink/70">Losses</div>
				<div class="text-3xl font-bold text-nutmeg font-mono">{ stats.Losses }</div>
			</div>
			<div class="bg-white p-4 rounded shadow border border-pitch/10 text-center">
				<div class="flex justify-center mb-1">@components.IconGoal("size-5 text-gold")</div>
				<div class="text-sm font-oswald text-ink/70">Goals</div>
				<div class="text-3xl font-bold text-gold font-mono">{ stats.Goals }</div>
			</div>
			<div class="bg-white p-4 rounded shadow border border-pitch/10 text-center">
				<div class="flex justify-center mb-1">@components.IconBoot("size-5 text-turf")</div>
				<div class="text-sm font-oswald text-ink/70">Assists</div>
				<div class="text-3xl font-bold text-turf font-mono">{ stats.Assists }</div>
			</div>
		</div>
		if stats.MatchesPlayed > 0 {
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
				<div class="bg-white p-4 rounded shadow border border-pitch/10">
					<h3 class="font-oswald text-sm text-ink/70 mb-2">Record</h3>
					<canvas id="player-chart-record"></canvas>
				</div>
				<div class="bg-white p-4 rounded shadow border border-pitch/10">
					<h3 class="font-oswald text-sm text-ink/70 mb-2">Goals per match</h3>
					<canvas id="player-chart-goals"></canvas>
				</div>
			</div>
			@templ.JSONScript("player-chart-data", chartData)
		}
	</div>
}
